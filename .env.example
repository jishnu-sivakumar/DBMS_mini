# --- PostgreSQL (used by docker-compose and the app) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=propfind_db
DB_PORT=5432
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/propfind_db

# --- Auth: long random string used to sign session JWTs ---
JWT_SECRET=change-me-to-a-long-random-string

# --- Seed: password given to the demo accounts by `npm run db:seed` ---
SEED_PASSWORD=password123

# --- Optional: OpenAI embeddings (leave empty to use local all-MiniLM-L6-v2) ---
OPENAI_API_KEY=

NODE_ENV=development

# Set to true only when served over HTTPS (marks the session cookie Secure)
COOKIE_SECURE=false

# Embedding model: seconds-in-ms to wait for the model to load, and whether the seed may use
# the offline hash fallback (not comparable with the real model, leave false)
EMBEDDING_LOAD_TIMEOUT_MS=60000
ALLOW_FALLBACK_EMBEDDINGS=false
