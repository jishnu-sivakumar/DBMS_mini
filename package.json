{
  "name": "propfind",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:init": "node --env-file-if-exists=.env scripts/init-db.mjs",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.mjs",
    "test:parser": "node scripts/test-parser.mjs",
    "postinstall": "node -e \"import fs from 'fs'; try { const p='node_modules/@huggingface/transformers/package.json'; const j=JSON.parse(fs.readFileSync(p)); j.exports.node.import.default='./dist/transformers.js'; fs.writeFileSync(p, JSON.stringify(j,null,2)); } catch(e){}\""
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.15",
    "lucide-react": "^0.460.0",
    "next": "^14.2.20",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3"
  }
}
